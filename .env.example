# Example environment variables. Do NOT commit real secrets.

# Postgres connection string for development (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/constructionhq

# JWT secret for session signing (generate a secure random value for production)
NEXTAUTH_SECRET=__CHANGE_ME__

# S3 / MinIO for file storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=constructionhq
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# App settings
NEXT_PUBLIC_APP_NAME=ConstructionHQ

